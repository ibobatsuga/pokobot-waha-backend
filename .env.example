# ==========================================
# PokoBot WAHA Cloud Backend Configuration
# ==========================================

# WAHA API Security Key (WAJIB diisi untuk server publik!)
# Gunakan string acak panjang, lalu masukkan key yang sama di PokoBot Device Manager
WAHA_API_KEY=ganti_dengan_api_key_rahasia_anda

# Port internal (Railway/Render otomatis mengisi PORT; default 3000)
WHATSAPP_API_PORT=3000

# Engine ringan tanpa Chromium/Puppeteer (sangat hemat RAM ~120MB)
WHATSAPP_DEFAULT_ENGINE=NOWEB

# Auto start & restart session saat container reboot
WHATSAPP_START_SESSION=default
WHATSAPP_RESTART_ALL_SESSIONS=True

# URL Publik server WAHA Anda (untuk link media webhook)
# Contoh: https://waha-production.up.railway.app
WAHA_PUBLIC_URL=

# Global Webhook menuju PokoBot SaaS
WHATSAPP_HOOK_URL=https://ping-clone-poc.vercel.app/api/webhook
WHATSAPP_HOOK_EVENTS=message,session.status

# Swagger UI (/dashboard /swagger)
WAHA_SWAGGER_ENABLED=true
